# Google Programmable Search JSON API (do not commit real values)
GOOGLE_CSE_API_KEY=replace_with_existing_customer_api_key
GOOGLE_CSE_ID=replace_with_programmable_search_engine_id

# EcoSort Qwen Vision backend — copy this file to .env.local and replace the value.
# This variable stays server-side and must never use the VITE_ prefix.
QWEN_API_KEY=sk-your-qwen-api-key-here
# Optional comma-separated production origins. Leave empty to allow same-origin requests.
QWEN_ALLOWED_ORIGINS=
