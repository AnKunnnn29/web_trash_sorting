{
  "name": "web-trash-sorting-steam",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "validate": "python scripts/validate_project.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "evaluate:ai": "py -3.7 scripts/evaluate_ai.py",
    "audit:data": "py -3.7 scripts/audit_dataset.py",
    "collect:boxed-milk": "python scripts/collect_boxed_milk_brands.py",
    "collect:google": "py -3.7 scripts/collect_google_images.py",
    "collect:google:plan": "py -3.7 scripts/collect_google_images.py --dry-run",
    "collect:open-images": "py -3.7 scripts/collect_open_images.py",
    "collect:milk-cartons": "py -3.7 scripts/collect_milk_carton_structured.py",
    "promote:milk-cartons": "py -3.7 scripts/promote_milk_carton_structured.py",
    "promote:open-images": "py -3.7 scripts/promote_open_images.py",
    "promote:boxed-milk": "python scripts/promote_boxed_milk_brands.py",
    "prepare:training-data": "py -3.7 scripts/prepare_training_split.py",
    "prepare:pretraining-assets": "py -3.7 scripts/prepare_pretraining_assets.py",
    "check:pretraining": "py -3.7 scripts/check_pretraining_readiness.py",
    "train:candidate:e2": "py -3.7 scripts/train_candidate.py --experiment E2",
    "train:candidate:e4": "py -3.7 scripts/train_candidate.py --experiment E4",
    "train:all:current": "py -3.7 scripts/train_all_current.py",
    "evaluate:clean-split": "py -3.7 scripts/evaluate_model_split.py --model saved_model_keras --output reports/baseline-clean-split.json",
    "summarize:training": "py -3.7 scripts/summarize_training.py",
    "test:brands": "py -3.7 scripts/evaluate_brand_smoke.py",
    "check": "npm run validate && npm run test && npm run build",
    "check:full": "npm run check && npm run test:e2e",
    "convert:tfjs": "tfjs-converter --input_format=tf_saved_model --output_format=tfjs_graph_model saved_model_keras public/tfjs_model"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tensorflow/tfjs": "^4.20.0",
    "@tensorflow/tfjs-converter": "^4.20.0",
    "vite": "^8.1.5",
    "vitest": "^3.2.7"
  }
}
